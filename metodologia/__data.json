s://www.careerjet.com.tr",46015,{"code":613,"service":28,"kind":13,"country":609,"url":614,"collecting_since":30,"offers_total":615,"fetch_via_pl":18},"indeed.tr","https://tr.indeed.com",32968,{"code":617,"service":34,"kind":13,"country":609,"url":618,"collecting_since":135,"offers_total":619,"fetch_via_pl":38},"jooble.tr","https://tr.jooble.org",19559,{"code":621,"service":21,"kind":13,"country":622,"url":299,"collecting_since":24,"offers_total":623,"fetch_via_pl":18},"careerjet.us","US",1842596,{"code":625,"service":28,"kind":13,"country":622,"url":626,"collecting_since":24,"offers_total":627,"fetch_via_pl":18},"indeed.us","https://www.indeed.com",5042224,{"code":629,"service":34,"kind":13,"country":622,"url":630,"collecting_since":36,"offers_total":631,"fetch_via_pl":38},"jooble.us","https://jooble.org",1132943,{"code":633,"service":12,"kind":13,"country":634,"url":635,"collecting_since":69,"offers_total":636,"fetch_via_pl":18},"tanqeeb.ye","YE","https://yemen.tanqeeb.com",228,{"title":638,"company":639,"city":640,"location_raw":638,"country":638,"external_id":638,"employment_type":641,"remote":642,"description":643,"posted_at":644,"salary_any":645,"salary_raw":645,"salary_min":646,"salary_max":646,"salary_currency":647},1,0.92,0.974,0.345,0.683,0.999,0.995,0.355,0.242,0.241,"2026-09-15T13:27:57.549197+00:00",[650,651,652,653,654,655,656],"Codziennie scrapery pobierają listingi i strony ogłoszeń z każdego serwisu; surowy HTML trafia do datalake (MinIO), a sparsowane pola - do tabeli ofert w Postgresie.","Ta sama oferta w tym samym serwisie jest liczona raz (klucz: adres URL lub identyfikator ogłoszenia); kolejne przebiegi tylko odnotowują, że nadal jest widoczna.","Oferta znika z serwisu -> dostaje datę zamknięcia; stąd liczba ogłoszeń dostępnych na koniec miesiąca.","Raz na dobę jeden przegląd całej tabeli ofert buduje agregaty (kraj x serwis x miesiąc); wskaźniki na stronie liczone są wyłącznie z tych agregatów.","Miesiąc ogłoszenia to data publikacji w serwisie, a gdy jej brak - dzień, w którym zobaczyliśmy je pierwszy raz (czas polski).","Powtórki między serwisami (ten sam tytuł, firma i miasto w tym samym miesiącu) zdejmujemy z liczby nowych ogłoszeń; odsetek powtórek pokazujemy osobno.","Wynagrodzenia sprowadzamy do stawki miesięcznej (godzina x 173,33, dzień x 21,67, tydzień x 4,333, rok / 12), bierzemy środek przedziału i odcinamy 1% skrajnych wartości.",[658,659,660,661,662,663,664],"Zbieranie trwa od lata 2026; wcześniejsze miesiące pochodzą z dat publikacji ogłoszeń widocznych w serwisach i są niepełne (starsze ogłoszenia zdążyły zniknąć).","Obserwujemy wybrane serwisy, nie cały rynek; udział portali różni się między krajami.","Wynagrodzenie podaje mniejszość ogłoszeń, a te, które je podają, nie są losową próbką.","Oznaczenie pracy zdalnej zależy od serwisu; brak oznaczenia nie znaczy, że praca jest stacjonarna.","Deduplikacja między serwisami jest szacunkowa: opiera się na tytule, firmie i mieście.","Regiony liczymy tylko tam, gdzie mamy słownik miast (Polska); ogłoszenia z mniejszych miejscowości nie wchodzą do udziałów województw.","Kursy walut w porównaniu krajów są stałe i orientacyjne.",{"AE":666,"AT":667,"AU":668,"BE":669,"BH":670,"CA":671,"CH":672,"CL":673,"CO":674,"CR":675,"CZ":676,"DE":677,"DK":678,"DZ":679,"EE":680,"EG":681,"ES":682,"FI":683,"FR":684,"GB":685,"GR":686,"HU":687,"IE":688,"IL":689,"IQ":690,"IS":691,"IT":692,"JO":693,"JP":694,"KR":695,"KW":696,"LB":697,"LT":698,"LU":699,"LV":700,"LY":701,"MA":702,"MX":703,"NL":704,"NO":705,"NZ":706,"OM":707,"PL":708,"PS":709,"PT":710,"QA":711,"SA":712,"SD":713,"SE":714,"SI":715,"SK":716,"SY":717,"TN":718,"TR":719,"US":720,"YE":721},"Zjednoczone Emiraty Arabskie","Austria","Australia","Belgia","Bahrajn","Kanada","Szwajcaria","Chile","Kolumbia","Kostaryka","Czechy","Niemcy","Dania","Algieria","Estonia","Egipt","Hiszpania","Finlandia","Francja","Wielka Brytania","Grecja","Węgry","Irlandia","Izrael","Irak","Islandia","Włochy","Jordania","Japonia","Korea Południowa","Kuwejt","Liban","Litwa","Luksemburg","Łotwa","Libia","Maroko","Meksyk","Holandia","Norwegia","Nowa Zelandia","Oman","Polska","Palestyna","Portugalia","Katar","Arabia Saudyjska","Sudan","Szwecja","Słowenia","Słowacja","Syria","Tunezja","Turcja","Stany Zjednoczone","Jemen"],"uses":{}}]}
